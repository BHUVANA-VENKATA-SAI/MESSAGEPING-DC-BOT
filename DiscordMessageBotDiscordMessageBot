
name: Test MessagePing Bot

on:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  test-bot:
    runs-on: ubuntu-latest
    timeout-minutes: 5

    steps:
      - name: Download repository
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Install dependencies
        working-directory: DiscordMessageBot
        run: |
          python -m pip install --upgrade pip
          pip install -r requirements.txt

      - name: Validate configuration and bot code
        working-directory: DiscordMessageBot
        env:
          DISCORD_BOT_TOKEN: ${{ secrets.DISCORD_BOT_TOKEN }}
          GUILD_ID: ${{ secrets.GUILD_ID }}
          ALLOWED_ROLE_IDS: ${{ secrets.ALLOWED_ROLE_IDS }}
        run: |
          python - <<'PY'
          import os
          import ast
          from pathlib import Path

          required = [
              "DISCORD_BOT_TOKEN",
              "GUILD_ID",
              "ALLOWED_ROLE_IDS",
          ]

          missing = [
              key for key in required
              if not os.environ.get(key, "").strip()
          ]

          if missing:
              raise SystemExit(
                  "Missing GitHub Actions secrets: "
                  + ", ".join(missing)
              )

          ast.parse(Path("bot.py").read_text(encoding="utf-8"))
          print("Configuration is present.")
          print("Python syntax is valid.")
          PY

      - name: Test Discord login
        working-directory: DiscordMessageBot
        env:
          DISCORD_BOT_TOKEN: ${{ secrets.DISCORD_BOT_TOKEN }}
          GUILD_ID: ${{ secrets.GUILD_ID }}
          ALLOWED_ROLE_IDS: ${{ secrets.ALLOWED_ROLE_IDS }}
        run: |
          python - <<'PY'
          import asyncio
          import os
          import discord

          async def main():
              client = discord.Client(
                  intents=discord.Intents.default()
              )
              try:
                  await client.login(
                      os.environ["DISCORD_BOT_TOKEN"]
                  )
                  print("Discord authentication successful.")
              finally:
                  await client.close()

          asyncio.run(main())
          PY
